# Public site URL for canonical and Open Graph metadata (use HTTPS in production)
SITE_URL=https://brightloop-odoo-mumble.vercel.app

# Auth.js (Step 3) — generate with: openssl rand -base64 32
AUTH_SECRET=

# PostgreSQL (Neon, Supabase, Docker, etc.). Required for prisma generate and runtime.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Seed script only — never commit real passwords
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_PASSWORD=

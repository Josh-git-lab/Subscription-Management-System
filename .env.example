# Public site URL for canonical and Open Graph metadata (use HTTPS in production; not localhost)
SITE_URL=https://brightloop.example.com

# Auth.js (Step 3) — generate with: openssl rand -base64 32
AUTH_SECRET=

# Database. `prisma generate` requires this variable and does not connect.
# Provider is sqlite, so the value must be a file: URL. A Postgres URL fails validation.
DATABASE_URL="file:./prisma/dev.db"

# Seed script only (development — never commit real passwords)
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_CUSTOMER_PASSWORD=
